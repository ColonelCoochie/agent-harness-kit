{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"/*AGENT_HARNESS_HOOK_V7*/const p=require('path'),f=require('fs');let d=process.cwd();for(;;){const h=p.join(d,'.harness','hooks','precompact.mjs');if(f.existsSync(h)){import(require('url').pathToFileURL(h).href).catch(()=>process.stdout.write('{}'));break}const u=p.dirname(d);if(u===d){process.stdout.write('{}');break}d=u}\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
