{
  "description": "Agent Harness worker-transfer persistence for automatic context compaction.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "^auto$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "commandWindows": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "timeout": 600,
            "statusMessage": "Persisting an orchestrated-worker packet before compaction"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "commandWindows": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "timeout": 30,
            "statusMessage": "Restoring bounded worker routing after compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "timeout": 600,
            "commandWindows": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "timeout": 600,
            "commandWindows": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "timeout": 600,
            "commandWindows": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\"",
            "timeout": 600,
            "commandWindows": "node -e \"const marker='HARNESS_HOOK_LAUNCHER_V3';eval(require('node:zlib').inflateRawSync(Buffer.from('','base64')).toString())\""
          }
        ]
      }
    ]
  }
}
