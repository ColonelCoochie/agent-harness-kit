{
  "hooks": {
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": {{IDENTITY_COMMAND}}, "timeout": 30 }] }],
    "PreCompact": [{ "matcher": "auto", "hooks": [{ "type": "command", "command": {{PRECOMPACT_COMMAND}}, "timeout": 600 }] }],
    "SessionStart": [{ "matcher": "compact", "hooks": [{ "type": "command", "command": {{SESSIONSTART_COMMAND}}, "timeout": 30 }] }]
  }
}
