{
  "description": "Merge this worker-transfer PreCompact group into the existing project .codex/hooks.json after review.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "^auto$",
        "hooks": [
          {
            "type": "command",
            "command": {{PRECOMPACT_COMMAND}},
            "commandWindows": {{PRECOMPACT_WINDOWS_COMMAND}},
            "timeout": 600,
            "statusMessage": "Persisting an orchestrated-worker packet before compaction"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": {{SESSIONSTART_COMMAND}},
            "commandWindows": {{SESSIONSTART_WINDOWS_COMMAND}},
            "timeout": 30,
            "statusMessage": "Restoring bounded worker routing after compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": {{CONTEXT_COMMAND}},
            "timeout": 600,
            "commandWindows": {{CONTEXT_WINDOWS_COMMAND}}
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": {{CONTEXT_COMMAND}},
            "timeout": 600,
            "commandWindows": {{CONTEXT_WINDOWS_COMMAND}}
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{CONTEXT_COMMAND}},
            "timeout": 600,
            "commandWindows": {{CONTEXT_WINDOWS_COMMAND}}
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{CONTEXT_COMMAND}},
            "timeout": 600,
            "commandWindows": {{CONTEXT_WINDOWS_COMMAND}}
          }
        ]
      }
    ]
  }
}
